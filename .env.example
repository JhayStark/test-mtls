PORT=3000
LOG_LEVEL=debug

# base64 of certs/ca.pem (printed by scripts/make-test-certs.sh)
SEC_VAMSS_CA_BUNDLE=
# Subject DN of the client cert the API key is bound to; \n separates RDNs
SEC_VAMSS_CLIENT_CERT_SUBJECT=C=GH\nO=SEC Ghana Sandbox\nCN=sec-vamss-client
SEC_VAMSS_SIGNING_SECRET=
# Comma-separated; empty allows all outside NODE_ENV=production
SEC_VAMSS_ALLOWED_CIDRS=

# From scripts/gen-api-key.sh
SEC_VAMSS_API_KEY_HASH=
SEC_VAMSS_API_KEY_PREFIX=
SEC_VAMSS_API_KEY_EXPIRES_AT=
SEC_VAMSS_API_KEY_REVOKED=false
